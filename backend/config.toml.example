# Stained Glass Odyssey: Endless - LRM reference template
# Copy to config.toml only for local reference.
# Runtime configuration is persisted in backend options via /config/lrm.

[lrm]
provider = "disabled"              # disabled | codex_cli
model = "openai/gpt-oss-120b"
reasoning_effort = "high"          # none | minimal | low | medium | high
summary = "detailed"               # auto | concise | detailed

[lrm.codex_cli]
# Optional timeout for Codex CLI calls.
# Equivalent env var: AF_LRM_TIMEOUT_SECONDS
# timeout_seconds = 20

# API usage examples:
# curl -s http://localhost:59002/config/lrm
# curl -s -X POST http://localhost:59002/config/lrm \
#   -H 'content-type: application/json' \
#   -d '{"provider":"codex_cli","model":"openai/gpt-oss-120b","reasoning_effort":"high","summary":"detailed"}'
# curl -s -X POST http://localhost:59002/config/lrm/test \
#   -H 'content-type: application/json' \
#   -d '{"prompt":"say hi in one sentence"}'
